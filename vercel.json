{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/v1/cron/retention-purge",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/v1/cron/publish-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/v1/cron/resend-retry",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/v1/cron/storage-backup",
      "schedule": "0 3 * * *"
    }
  ]
}
