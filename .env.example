# Tech Groww Platform — Environment Variable Specification (DEMO / Template Only)
# Copy to .env.local for local development. NEVER commit real secrets to git.

# Public Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Public client key + Server-only elevated key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Direct Postgres URLs (Migrations / CLI only)
DATABASE_URL=
DIRECT_URL=

# Cryptographic Salts & Token Signing (32-byte hex/base64 secrets)
AUTH_SECRET=replace-with-32-byte-random-secret
IP_HASH_SALT=replace-with-distinct-32-byte-random-salt

# Upstash Redis (Distributed Rate Limiting & Redirect Cache Invalidation)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (Anti-Bot Verification)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Workspace Staff OAuth & Optional Sheets Mirror
# Note: Google OAuth Client ID & Secret are configured directly inside Supabase Auth Dashboard.
GOOGLE_WORKSPACE_ALLOWED_DOMAIN=techgroww.co.in
GOOGLE_SHEETS_LEADS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Resend Email Delivery & Webhooks
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tech Groww <noreply@send.techgroww.co.in>
RESEND_AUDIENCE_ID=
RESEND_WEBHOOK_SECRET=

# Supabase Storage Buckets
STORAGE_MEDIA_BUCKET=public-media
STORAGE_PRIVATE_BUCKET=private-vault

# Vercel Cron Auth
CRON_SECRET=replace-with-random-cron-secret

# Optional Analytics & Monitoring (GA4 loads ONLY after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Portal Launch Contingency Feature Flags (Default true = All 5 Portals active)
PORTAL_CLIENT_ENABLED=true
PORTAL_INTERN_ENABLED=true
